# Beam+ (tx011) and BeamPro (st001) motor boards -> /dev/beam-motor
SUBSYSTEM=="tty", ATTRS{idVendor}=="25a1", ATTRS{idProduct}=="000b", SYMLINK+="beam-motor", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="25a1", ATTRS{idProduct}=="0001", SYMLINK+="beam-motor", GROUP="dialout", MODE="0660"
# Beam+ head and nav cameras (UVC)
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="25a1", ATTRS{idProduct}=="0006", ATTR{index}=="0", SYMLINK+="video-head"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="25a1", ATTRS{idProduct}=="0007", ATTR{index}=="0", SYMLINK+="video-nav"
# Cameras still in their bootloader (no firmware yet): load it. Runs at boot and after any camera reset.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="25a1", ATTR{idProduct}=="4006|4007", TAG+="systemd", ENV{SYSTEMD_WANTS}+="beam-cameras.service"
# Screen backlight: the motor server (user beamsrv) turns it off in sleep mode
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp beamsrv /sys%p/brightness", RUN+="/bin/chmod g+w /sys%p/brightness"
